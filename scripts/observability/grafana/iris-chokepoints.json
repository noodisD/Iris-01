{
  "uid": "iris-chokepoints",
  "title": "IRIS chokepoints",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operations per second",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (span_kind) (rate(traces_spanmetrics_calls_total{service=\"iris\"}[$__rate_interval]))",
        "legendFormat": "{{span_kind}}",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per second",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"iris\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
        "legendFormat": "{{span_name}}",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "95th percentile by kind (s)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "histogram_quantile(0.95, sum by (le, span_kind) (rate(traces_spanmetrics_latency_bucket{service=\"iris\"}[$__rate_interval])))",
        "legendFormat": "{{span_kind}}",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Slowest operations, p95 over 15 min",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "topk(15, histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"iris\"}[15m]))))",
        "refId": "A",
        "instant": true,
        "format": "table"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingest queue by state",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (state) (iris_queue_items{job=\"iris\"})",
        "legendFormat": "{{state}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oldest due item (s)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "iris_queue_oldest_due_age_seconds{job=\"iris\"} or on() vector(0)",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Database connections",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "iris_db_pool_connections{job=\"iris\"}",
          "legendFormat": "pool {{state}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "iris_db_server_sessions{job=\"iris\"}",
          "legendFormat": "server {{state}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Event loop lag (s)",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "iris_process_loop_lag_seconds{job=\"iris\"}",
        "refId": "A"
      }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"iris\"}[$__rate_interval]))",
        "legendFormat": "{{http_route}}",
        "refId": "A"
      }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Process memory",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "iris_process_memory_rss_bytes{job=\"iris\"}",
        "refId": "A"
      }]
    }
  ]
}
