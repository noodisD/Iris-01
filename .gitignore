# Secrets (DO NOT TRACK)
# Environment files with sensitive credentials - NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.staging
**/.env

# Templates (TRACK THESE)
# Only track .env.example with placeholder values, never actual credentials
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
.venv/

# Databases & Local Data
data/
*.sqlite3
*.db
.pytest_cache/

# Git Worktrees
.worktrees/

# Runtime logs (may contain user-derived content)
logs/
*.log

# Build artifacts
frontend/dist/
frontend/node_modules/
*.tsbuildinfo

# Local agent tooling settings
.claude/settings.local.json
