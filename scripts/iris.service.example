# IRIS as a systemd *user* service: starts at boot, waits for the database,
# restarts on failure. No root needed.
#
#   cp scripts/iris.service.example ~/.config/systemd/user/iris.service
#   systemctl --user daemon-reload && systemctl --user enable --now iris
#   loginctl enable-linger "$USER"     # start at boot, before anyone logs in
#   sudo systemctl enable docker       # PostgreSQL runs in a Docker container
#
# Restart:  systemctl --user restart iris
# Logs:     journalctl --user -u iris -f
#
# serve_iris.py opens the web UI on 127.0.0.1:8000, the tailnet door on
# 127.0.0.1:8001 for `tailscale serve`, and the phone listener when
# LAN_BIND_HOST is set (ADR-0022). IRIS is single-user: never expose these
# ports to a network directly.

[Unit]
Description=IRIS, personal companion (web :8000, tailnet door :8001, phone listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Iris-01
EnvironmentFile=%h/Iris-01/.env
# Up to two minutes for the database container after a boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do pg_isready -q -h localhost -p 5432 && exit 0; sleep 2; done; echo "PostgreSQL did not answer; is Docker running?" >&2; exit 1'
ExecStart=%h/Iris-01/.venv/bin/python scripts/serve_iris.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=150

[Install]
WantedBy=default.target
