# ----- Iris / Iris frontend -----
# Copy to .env.local and fill in real values.

# Base URL of your backend (in dev, /api is proxied to this via vite.config.ts)
VITE_BACKEND_URL=http://localhost:8080

# Flip to "true" to use in-memory mock data instead of hitting the backend.
# Useful for designers and offline frontend work.
VITE_USE_MOCKS=true

# Optional — feature flags
VITE_FEATURE_FITBIT_AIR=true
VITE_FEATURE_CONSTELLATION=true
