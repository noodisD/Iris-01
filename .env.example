# IRIS configuration. Copy to .env and fill in.
# Only the variables listed here are read by the application.

# --- OpenAI (required) ---
# Chat and embeddings. Nothing else leaves the machine.
OPENAI_API_KEY=sk-your-key-here
# Model used for chat, the weekly letter and theme naming.
OPENAI_MODEL=gpt-4.1-mini

# --- PostgreSQL (required) ---
# Must have the pgvector extension available; see README.
POSTGRES_DB=iris_db
POSTGRES_USER=iris_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Single-user identity (optional) ---
# IRIS is a personal, loopback-only app with no login. These name the one local
# user row; there is rarely a reason to change them.
# IRIS_DEFAULT_USER=local
# IRIS_DEFAULT_PASSWORD=local

# --- Behaviour (optional) ---
# Log level for the agent package: DEBUG | INFO | WARNING | ERROR.
# LOG_LEVEL=INFO
# Narrative firewall: "raise" surfaces template failures, "silence" drops the
# offending insight and continues.
# NARRATIVE_FAIL_MODE=raise
