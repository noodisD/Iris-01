# IRIS Companion - Environment Configuration Template
# Copy this to .env and fill in the values.

# --- SYSTEM SETTINGS ---
ENV=dev # dev | prod
LOG_LEVEL=INFO # debug | info | warning | error

# --- API KEYS ---
OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-gemini-key-here (optional fallback)

# --- POSTGRESQL (Source of Truth) ---
POSTGRES_DB=iris_db
POSTGRES_USER=iris_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- NEO4J (Graph Lens) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password

# --- ANALYICAL GATES (Global Defaults) ---
# These can be overridden by user preferences in the DB
DEFAULT_MIN_CONFIDENCE=medium
DEFAULT_MAX_CONTEXT_ITEMS=5

# --- FEATURE FLAGS ---
CONFLICT_SUPPRESSION_ENABLED=true
NARRATIVE_FAIL_MODE=raise # raise (dev) | silence (prod)