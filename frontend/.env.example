# ----- IRIS frontend -----
# Copy to .env.local. In development, leave VITE_BACKEND_URL empty: the client
# then calls /api/* on the Vite dev server (:5173), which proxies to FastAPI on
# :8000 per vite.config.ts. Same-origin, so no CORS.
#
# Set it only when the API lives somewhere other than the process serving this
# app (in production the FastAPI process serves the built SPA itself).
VITE_BACKEND_URL=
